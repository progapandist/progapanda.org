#!/bin/sh
# stripeek needs a wide screen and a keyboard, and a phone has neither. The web
# server passes POINTER in from the browser, which is the only place that knows
# whether there is a mouse; the width we can just measure.
#
cols=$(stty size 2>/dev/null | cut -d' ' -f2)
case "$cols" in
	''|*[!0-9]*) cols=${COLUMNS:-80} ;;
esac

if [ "$POINTER" = "coarse" ] || [ "$cols" -lt 80 ]; then
	printf '\033[38;5;212mstripeek needs a desktop.\033[0m\n'
	echo ""
	echo "It is a wide, keyboard-driven"
	echo "inspector. Open progapanda.org"
	echo "on a computer to try it."
	exit 0
fi

# stripeek appends to its history and can clear it, and /app is root-owned
# while visitors are uid 1000 — so work on a copy. A fresh container gets a
# fresh one, which is the whole point of the sandbox.
history=/tmp/stripeek-history.json
[ -f "$history" ] || cp /app/stripeek-history.json "$history"
export STRIPEEK_HISTORY_PATH="$history"

exec /app/stripeek.bin "$@"
