# The per-visitor container: a TUI, a Stripe inspector, and a shell.
#
# Standalone, if you want to run the TUI on its own:
#   docker build -f Dockerfile.visitor -t hello2 . && docker run --rm -it hello2
FROM golang:1.26.3-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/hello2 ./cmd/hello2
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /hello2 ./cmd/hello2

# A separate module, so it is fetched by version rather than vendored here.
FROM golang:1.26.3-alpine AS stripeek
ARG STRIPEEK_VERSION=v0.1.3
RUN CGO_ENABLED=0 go install -ldflags="-s -w" github.com/progapandist/stripeek/cmd/stripeek@${STRIPEEK_VERSION}

FROM golang:1.26.3-alpine AS tja
ARG TJA_VERSION=v0.4.1
RUN CGO_ENABLED=0 go install -ldflags="-s -w" github.com/progapandist/tja@${TJA_VERSION}

FROM alpine
WORKDIR /app
COPY --from=build /hello2 ./hello2
COPY --from=stripeek /go/bin/stripeek ./stripeek.bin
COPY --from=tja /go/bin/tja ./tja
COPY visitor/ ./
ENV TERM=xterm-256color
# So `stripeek`, `tja` and `hello2` work without ./ — the TUI tells visitors to type
# the bare name, and being told to type something that then fails is worse than
# not mentioning it.
ENV PATH="/app:$PATH"
ENTRYPOINT ["./entrypoint.sh"]
CMD ["./hello2"]
